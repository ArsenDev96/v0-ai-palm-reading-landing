# Supabase — server-only credentials used by lib/supabase/admin.ts.
# The service role / secret key bypasses RLS, so keep it secret and never
# expose it to the client. Copy this file to `.env.local` and fill in real
# values. (The new Supabase "Secret key", sb_secret_..., works here too.)
#
# IMPORTANT: SUPABASE_URL must be the base project URL only — do NOT append
# /rest/v1 or any path. The client adds those itself.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# OpenAI — powers the real palm reading (vision). lib/ai/palm.ts sends the
# uploaded photo to OpenAI and asks it to read the palm lines.
# Get the key from https://platform.openai.com/api-keys.
# OPENAI_MODEL is optional; it must be a vision-capable model (default gpt-4o).
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# SMTP (transactional email) — used by lib/email/mailer.ts (Nodemailer) to send
# the full reading. Configured for Zoho Mail below; any SMTP provider works.
# For Zoho: enable IMAP/SMTP access and, if 2FA is on, create an app-specific
# password (Zoho → Settings → Security → App Passwords) and use it as SMTP_PASS.
# Use smtp.zoho.eu instead of smtp.zoho.com for EU-region accounts.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=yourfate4@zohomail.com
SMTP_PASS=your-zoho-app-password
MAIL_FROM_EMAIL=yourfate4@zohomail.com
MAIL_FROM_NAME=Your Fate
# Where "Contact us" messages are delivered. Optional — defaults to
# MAIL_FROM_EMAIL (i.e. the sending mailbox) when left unset.
CONTACT_RECIPIENT=yourfate4@zohomail.com
